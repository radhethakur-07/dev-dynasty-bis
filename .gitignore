# ============================================================
# DEV DYNASTY — BIS Intelligence Assistant (SIH267107)
# .gitignore — Comprehensive exclusions
# ============================================================

# ────────────────────────────────────────────
# PYTHON
# ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python lib folders only (not client/src/lib)
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
ENV/

# ────────────────────────────────────────────
# NODE / NEXT.JS
# ────────────────────────────────────────────
node_modules/
.next/
out/
build/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ────────────────────────────────────────────
# ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
server/.env
client/.env.local
*.pem
*.key
*.cert

# ────────────────────────────────────────────
# GENERATED DATA FILES (too large / regeneratable)
# ────────────────────────────────────────────
server/data/knowledge_store.json
server/data/reports/ingestion_checkpoint.json
server/data/reports/ingestion_report.json
server/data/reports/qa_retrieval_report.json
server/data/reports/data_quality_report.md

# ────────────────────────────────────────────
# IDE & OS
# ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ────────────────────────────────────────────
# LOGS
# ────────────────────────────────────────────
*.log
logs/
server/logs/

# ────────────────────────────────────────────
# MISC
# ────────────────────────────────────────────
*.tmp
*.bak
*.orig
.cache/
