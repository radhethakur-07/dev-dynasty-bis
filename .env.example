# ============================================================
# DEV DYNASTY — SIH267107: BIS INTELLIGENCE ASSISTANT
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

# ------------------------------------------------------------
# SERVER CONFIGURATION (server/.env)
# ------------------------------------------------------------
# Server runtime environment: 'development' or 'production'
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CLIENT_URL=http://localhost:3000

# AI Provider: Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Configurable embedding dimension (e.g. 768 or dimension matching selected model)
EMBEDDING_DIMENSION=768

# Database: Supabase PostgreSQL + pgvector
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Auth (JWT + Brevo Email)
JWT_SECRET=your_random_jwt_secret_min_32_chars
BREVO_API_KEY=your_brevo_api_key_here        # Optional: leave blank for demo mode (OTP shown in logs)

# ------------------------------------------------------------
# CLIENT CONFIGURATION (client/.env.local)
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Dev Dynasty - BIS Intelligence Assistant"
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
